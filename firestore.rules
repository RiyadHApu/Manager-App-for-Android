rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Replace with the email addresses of the people allowed to use the app.
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'owner@example.com',
          'staff1@example.com'
        ];
    }
  }
}
